# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/igcse_smart_school

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin bootstrap (used by seed.js to create the first Super Admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@igcsesmartschool.com
ADMIN_PASSWORD=ChangeMe123!

# Email (SMTP) - used for form confirmation/notification emails
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
EMAIL_FROM="IGCSE Smart School" <no-reply@igcsesmartschool.com>
ADMISSIONS_NOTIFY_EMAIL=admissions@igcsesmartschool.com
HR_NOTIFY_EMAIL=careers@igcsesmartschool.com
CONTACT_NOTIFY_EMAIL=info@igcsesmartschool.com

# Google reCAPTCHA v3
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
